# Required control-plane identity
MULTIREMI_SERVER_URL=https://REPLACE_WITH_MULTIREMI_SERVER
MULTIREMI_TOKEN=REPLACE_WITH_DAEMON_TOKEN
MULTIREMI_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_ID
MULTIREMI_BOT_AGENT_ID=REPLACE_WITH_BOT_AGENT_ID

# Required Feishu bot credentials
FEISHU_APP_ID=REPLACE_WITH_FEISHU_APP_ID
FEISHU_APP_SECRET=REPLACE_WITH_FEISHU_APP_SECRET

# Connector options
FEISHU_PORT=9000
FEISHU_DOMAIN=feishu
# FEISHU_VERIFICATION_TOKEN=REPLACE_WITH_VERIFICATION_TOKEN
# FEISHU_ENCRYPT_KEY=REPLACE_WITH_ENCRYPT_KEY
# FEISHU_USER_ACCESS_TOKEN=REPLACE_WITH_USER_ACCESS_TOKEN

# Optional integrations and runtime behavior
REMI_LOG_LEVEL=INFO
# GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
# REMI_TOKEN_SYNC_RULES_JSON='[]'
# REMI_PLUGINS_DIR=/opt/remi/plugins
# REMI_PLUGINS_ENABLED_JSON='[]'
# REMI_PLUGINS_ALLOW_EXTERNAL=false
# REMI_PLUGIN_CONFIGS_JSON='{}'
