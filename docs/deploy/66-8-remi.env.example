# Daemon process connection. Use a protected EnvironmentFile or saved CLI config.
# Workspace bot identity and application secrets are managed by the control plane.
MULTIREMI_SERVER_URL=https://REPLACE_WITH_MULTIREMI_SERVER
MULTIREMI_TOKEN=REPLACE_WITH_DAEMON_CREDENTIAL
MULTIREMI_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_ID

# Optional worker selection and persistent workspace location.
# Leave provider unset to discover healthy installed providers.
# MULTIREMI_PROVIDER=codex
# MULTIREMI_WORKSPACES_ROOT=/home/REPLACE_WITH_SERVICE_USER/.remi/multiremi/workspaces
MULTIREMI_DAEMON_PORT=6131

# Storage reclaim (machine settings). The retention policy itself (TTLs, cap,
# snapshot limit, chat idle days) is the workspace setting `storage`, managed with
# `remi workspace storage set`; the variables below only override this machine.
MULTIREMI_GC_ENABLED=true
MULTIREMI_GC_INTERVAL_MS=900000
# Plan and report only; nothing is deleted while true.
# MULTIREMI_GC_DRY_RUN=false
# Days the pre-upgrade layout stays in legacy-<date>/ before it is deleted.
# MULTIREMI_LEGACY_KEEP_DAYS=7
# Per-machine overrides of the workspace storage policy.
# MULTIREMI_GC_TTL_MS=259200000
# MULTIREMI_GC_AUTOMATION_TTL_MS=86400000
# MULTIREMI_GC_MAX_RETAINED=50
# MULTIREMI_GC_ORPHAN_TTL_MS=259200000
# MULTIREMI_GC_SNAPSHOT_MAX_BYTES=268435456

# Poll cadence. Heartbeat and task claim are independent timers. Every
# long-running daemon is offered the Feishu concierge host so the bot can be
# handed to any of them, but only the Runtime the control plane actually assigns
# it to keeps a 3s heartbeat; this value replaces the normal interval only.
# MULTIREMI_HEARTBEAT_INTERVAL_MS=10000
# Idle claim backoff ceiling (3s -> 6s -> 12s -> 24s -> this value).
# MULTIREMI_CLAIM_IDLE_MAX_MS=30000
# Fallback desired-Plugin refresh used only against a server that does not
# report a desired revision in the heartbeat ack.
# MULTIREMI_PLUGIN_DESIRED_REFRESH_MS=30000
# Ceiling for the terminal-authority register probe (30s -> 1m -> 2m -> 4m -> 8m -> this value).
# MULTIREMI_AUTHORITY_PROBE_MAX_MS=900000

# Native subagent sessions on the Claude/Codex ACP bridges and Claude's late
# answers to background subagents (autonomous rounds). Both default on; set 0
# to restore the previous behaviour (docs/adr/0021).
# REMI_ACP_NATIVE_SUBAGENTS=0
# REMI_ACP_AUTONOMOUS_ROUNDS=0
