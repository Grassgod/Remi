# Required before enabling workspace SSH Mesh. Generate once with:
#   openssl rand -base64 32
MULTIREMI_SSH_MESH_ENCRYPTION_KEY=

# Optional: join the Multiremi API host to SSH Mesh without registering it as
# a Runtime. Keep the root outside release/worktree directories.
MULTIREMI_SSH_MESH_CONTROL_PLANE=
MULTIREMI_SSH_MESH_CONTROL_PLANE_NODE_ID=
MULTIREMI_SSH_MESH_CONTROL_PLANE_DISPLAY_NAME=
MULTIREMI_SSH_MESH_CONTROL_PLANE_WORKSPACE_IDS=local
MULTIREMI_SSH_MESH_CONTROL_PLANE_ROOT=
