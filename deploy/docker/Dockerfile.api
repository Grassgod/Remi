FROM oven/bun:1.3.14 AS runtime

WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git gosu openssh-client passwd \
  && git --version \
  && rm -rf /var/lib/apt/lists/*

COPY . .
RUN bun install --registry https://registry.npmjs.org --frozen-lockfile --ignore-scripts \
  && rm -rf /root/.bun/install/cache \
  && chmod 0755 /app/deploy/docker/api-entrypoint.sh

EXPOSE 6120
ENTRYPOINT ["/app/deploy/docker/api-entrypoint.sh"]
CMD ["bun", "run", "apps/server/main.ts", "serve"]
