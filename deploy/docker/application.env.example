REMI_API_IMAGE=multiremi-api:replace-with-immutable-build-id
REMI_WEB_IMAGE=multiremi-web:replace-with-immutable-build-id
REMI_API_ENV_FILE=/etc/multiremi/api.env
REMI_CONTROL_PLANE_ENV_FILE=/etc/multiremi/control-plane.env
REMI_HOME_DIR=/srv/multiremi/home
REMI_UPLOAD_DIR=/srv/multiremi/uploads
REMI_SESSION_ARCHIVE_ROOT=/srv/multiremi/session-archives
REMI_SSH_MESH_ROOT=/srv/multiremi/ssh-mesh
REMI_SSH_HOME_DIR=/home/multiremi/.ssh
REMI_SSH_USER=multiremi
REMI_CONTROL_PLANE_HOSTNAME=multiremi-control-plane
REMI_RUNTIME_UID=1000
REMI_RUNTIME_GID=1000
REMI_API_BIND_PORT=16120
REMI_WEB_BIND_PORT=13000
REMI_POSTGRES_NETWORK=multiremi-postgres
REMI_OPENVIKING_NETWORK=multiremi-openviking
REMI_POSTGRES_CONTAINER=multiremi-postgres-1
REMI_OPENVIKING_CONTAINER=multiremi-openviking
REMI_BACKGROUND_JOBS=0
REMI_SSH_MESH_CONTROL_PLANE=0

# --- Split API roles (optional, off by default) ----------------------------
# Nothing to set here for the default single-process deployment: with
# REMI_API_ROLE unset the `api` container keeps its default role, its /health
# and /readyz payloads stay exactly as they are today, and the peer channel
# stays off.
#
# This file is the Compose env file: `docker compose` reads it to interpolate
# the compose file. REMI_API_ROLE and REMI_API_PEER_URL are Compose variables
# and must be set here (or in the calling environment), not in the API env
# file. The services define both keys in their own `environment` block, and that
# wins over `env_file`. MULTIREMI_PEER_SECRET is the opposite: the API
# process reads that one, so it goes in the API env file, next to
# MULTIREMI_TOKEN (and defaults to it when unset).
#
# The switch is two stages; see README.md, "Split API roles", for the steps and
# the rollback order. Stage A sets the peer URL and starts the second container
# with `--profile split`; stage B, run only after stage A is stable, sets the
# role so a misrouted daemon request is rejected loudly.
#
# Stage A:
# REMI_API_PEER_URL=http://api-runtime:6120
# REMI_API_RUNTIME_BIND_PORT=16121
#
# Stage B (after the observation window):
# REMI_API_ROLE=ui

# --- Feishu message ingestion (optional, off by default) --------------------
# Nothing to set here. lark-cli ships inside the API image and reads its
# credential from the API container's home directory, so ingestion needs no
# service, image, port, or endpoint registry. Turn it on by logging in once:
#
#   docker compose exec api lark-cli login
#
# then add a connection and a source in Settings -> Messages. The credential
# stays in the home bind mount; never put it in an env file or in Git.
