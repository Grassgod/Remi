REMI_API_IMAGE=multiremi-api:replace-with-immutable-build-id
REMI_WEB_IMAGE=multiremi-web:replace-with-immutable-build-id
REMI_API_ENV_FILE=/etc/multiremi/api.env
REMI_CONTROL_PLANE_ENV_FILE=/etc/multiremi/control-plane.env
REMI_HOME_DIR=/srv/multiremi/home
REMI_UPLOAD_DIR=/srv/multiremi/uploads
REMI_SESSION_ARCHIVE_ROOT=/srv/multiremi/session-archives
REMI_SSH_MESH_ROOT=/srv/multiremi/ssh-mesh
REMI_SSH_HOME_DIR=/home/multiremi/.ssh
REMI_SSH_USER=multiremi
REMI_CONTROL_PLANE_HOSTNAME=multiremi-control-plane
REMI_RUNTIME_UID=1000
REMI_RUNTIME_GID=1000
REMI_API_BIND_PORT=16120
REMI_WEB_BIND_PORT=13000
REMI_POSTGRES_NETWORK=multiremi-postgres
REMI_OPENVIKING_NETWORK=multiremi-openviking
REMI_POSTGRES_CONTAINER=multiremi-postgres-1
REMI_OPENVIKING_CONTAINER=multiremi-openviking
REMI_BACKGROUND_JOBS=0
REMI_SSH_MESH_CONTROL_PLANE=0

# --- Feishu message ingestion (optional, off by default) --------------------
# The sidecar runs only when its profile is enabled. Leave COMPOSE_PROFILES
# empty to keep the current API/Web/control-plane topology unchanged.
# COMPOSE_PROFILES=feishu-sidecar
# REMI_FEISHU_SIDECAR_IMAGE=hub.example.internal/personal-automation:<version>
#
# Endpoint registry consumed by the API. Names are what the control panel and
# CLI reference; the URL never leaves the server and is never accepted from a
# browser or a task token. The sidecar shares the API container's network
# namespace, so the only valid value is loopback — an external address would
# both break the topology and turn this into an SSRF sink.
# REMI_FEISHU_SIDECAR_ENDPOINTS=personal=http://127.0.0.1:8042
#
# Sidecar state. Point these at an existing personal-automation deployment's
# volumes only after that deployment's container is stopped.
# REMI_FEISHU_SIDECAR_DATA_VOLUME=multiremi-feishu-sidecar-data
# REMI_FEISHU_SIDECAR_HOME_VOLUME=multiremi-feishu-sidecar-home
