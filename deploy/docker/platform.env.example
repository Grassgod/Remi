POSTGRES_DB=multiremi
POSTGRES_USER=multiremi
POSTGRES_PASSWORD=replace-with-a-long-random-password
REMI_API_IMAGE=ghcr.io/OWNER/remi-api@sha256:replace-with-release-digest
REMI_WEB_IMAGE=ghcr.io/OWNER/remi-web@sha256:replace-with-release-digest
REMI_API_ENV_FILE=/etc/multiremi/api.env
REMI_UPLOAD_DIR=/srv/multiremi/uploads
REMI_SESSION_ARCHIVE_ROOT=/srv/multiremi/session-archives
REMI_SSH_MESH_ROOT=/srv/multiremi/ssh-mesh
REMI_RUNTIME_UID=1000
REMI_RUNTIME_GID=1000
REMI_API_BIND_PORT=6120
REMI_WEB_BIND=0.0.0.0
REMI_WEB_BIND_PORT=3000
OPENVIKING_IMAGE=ghcr.io/volcengine/openviking:v0.4.14@sha256:replace-with-verified-digest
OPENVIKING_STATE_DIR=/srv/openviking/state
OPENVIKING_WORKSPACE_DIR=/srv/openviking/workspace
OPENVIKING_CONFIG_FILE=/etc/openviking/ov.conf
OPENVIKING_SECRET_FILE=/etc/openviking/ovcli.conf
