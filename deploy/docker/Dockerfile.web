FROM oven/bun:1.3.14 AS builder

WORKDIR /app
ENV NODE_ENV=production
ENV STANDALONE=true
ARG REMOTE_API_URL=http://api:6120
ENV REMOTE_API_URL=$REMOTE_API_URL

# Cap Next's build worker pool when the builder's memory budget is smaller than
# its visible CPU count suggests. Empty by default, so the official release
# build keeps Next's own sizing. See next.config.ts and MUL-303.
ARG NEXT_BUILD_CPUS=""
ENV NEXT_BUILD_CPUS=$NEXT_BUILD_CPUS

COPY . .
RUN bun install --registry https://registry.npmjs.org --frozen-lockfile --ignore-scripts \
  && bun run --filter @multiremi/web build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder --chown=node:node /app/frontend/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/frontend/apps/web/.next/static ./frontend/apps/web/.next/static
COPY --from=builder --chown=node:node /app/frontend/apps/web/public ./frontend/apps/web/public

USER node
EXPOSE 3000
CMD ["node", "frontend/apps/web/server.js"]
