# Multiremi API environment
#
# Copy this file outside the Git checkout (for example, /etc/multiremi/api.env),
# replace every active placeholder, and set mode 0600. Optional settings stay
# commented out until the corresponding feature is enabled.

# Required in production. "Production" means NODE_ENV=production, or NODE_ENV
# unset while MULTIREMI_DATABASE_URL is configured. An explicit NODE_ENV of
# development or test is never production, so a local Postgres server keeps
# starting without a token or JWT secret.
# No default. Without it the production API refuses to start instead of falling
# back to a local SQLite database.
MULTIREMI_DATABASE_URL=postgresql://replace-with-db-user:replace-with-db-password@postgres:5432/replace-with-db-name

# Required in production. No default. Without it the production API refuses to
# start; without auth all non-public API routes would otherwise be open.
MULTIREMI_TOKEN=replace-with-long-random-platform-token

# Required in production. Development/test default:
# multiremi-dev-secret-change-in-production. Without it the production API
# refuses to start and dashboard JWT authentication cannot work.
JWT_SECRET=replace-with-long-random-jwt-secret

# Optional. Default: unset. Without it Session Archive direct upload is disabled
# and archives fall back to the 8 MiB proxy channel, so every larger upload fails.
# MULTIREMI_DAEMON_DIRECT_BASE_URL=https://replace-with-api-origin.example.com

# Optional. Default: unset. Without it the host platform updater cannot
# authenticate to updater-only API routes; normal API operation is unaffected.
# MULTIREMI_PLATFORM_UPDATER_TOKEN=replace-with-independent-updater-token

# Optional. Default: MULTIREMI_TOKEN, or an in-memory random value when that is
# also unset. Without a stable value, signed share links become invalid after an
# unauthenticated local API restart.
# MULTIREMI_SHARE_SECRET=replace-with-long-random-share-secret

# Optional. Default: request origin. Without it daemon setup instructions and
# outbound notification links use the request/publication context instead.
# MULTIREMI_PUBLIC_URL=https://replace-with-public-origin.example.com

# Optional. Default: unset (Feishu SSO disabled). Without both app ID and secret,
# /auth/lark cannot start the Feishu/Lark login flow.
# MULTIREMI_LARK_APP_ID=replace-with-lark-app-id
# MULTIREMI_LARK_APP_SECRET=replace-with-lark-app-secret

# Optional. Default: Feishu (open.feishu.cn). Set to "lark"/"larksuite" for
# Lark global, or an operator-controlled API origin. Without it Feishu is used.
# MULTIREMI_LARK_DOMAIN=lark

# Optional. Default: disabled. Without it email-code and Google fallback login
# stay disabled in production, leaving configured SSO as the login path.
# MULTIREMI_ALLOW_EMAIL_CODE_LOGIN=false

# Optional. Default: time-varying code derived from MULTIREMI_TOKEN. Without it
# explicitly enabled local email-code login still works with the derived code.
# MULTIREMI_LOCAL_AUTH_CODE=replace-with-fixed-local-login-code

# Optional. Default: unset. Without it Google login is not advertised by the
# public frontend config endpoint.
# GOOGLE_CLIENT_ID=replace-with-google-client-id

# Optional. Defaults: ANALYTICS_DISABLED=false; POSTHOG values unset. Without a
# key/host analytics is not initialized; set ANALYTICS_DISABLED=true to force it off.
# ANALYTICS_DISABLED=true
# POSTHOG_API_KEY=replace-with-posthog-project-key
# POSTHOG_HOST=https://replace-with-posthog-origin.example.com

# Optional. Default: unset (webhook signatures are not required). Without it SCM
# webhook payloads rely on their path token and rate limits rather than HMAC.
# MULTIREMI_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# Optional. Default: empty. Without it X-Forwarded-For is ignored and webhook
# rate limiting uses the direct peer address.
# MULTIREMI_TRUSTED_PROXY_IPS=replace-with-comma-separated-proxy-ips

# Optional. Default: MULTIREMI_TOKEN-derived key. Without a dedicated key SCM
# credentials remain encrypted but rotate whenever the platform token rotates.
# Must be a base64-encoded 32-byte value.
# MULTIREMI_SCM_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Optional. Default: empty. Without old keys, credentials encrypted before an SCM
# key rotation cannot be decrypted. Values are comma-separated base64 keys.
# MULTIREMI_SCM_ENCRYPTION_PREVIOUS_KEYS=replace-with-previous-base64-keys

# Optional. Default: GitHub plus configured Codebase hosts only. Without entries,
# custom SCM API hosts are rejected to prevent server-side request forgery.
# MULTIREMI_SCM_ALLOWED_API_HOSTS=replace-with-comma-separated-hosts

# Optional. Default: false. Without it custom SCM API URLs must use HTTPS.
# MULTIREMI_SCM_ALLOW_INSECURE_HTTP=0

# Optional. Default: sql. Without it project docs and repository wiki stay in the
# SQL database; shadow/openviking modes require an OpenViking API key at startup.
# MULTIREMI_PROJECT_KNOWLEDGE_MODE=sql

# Optional for sql mode; required by shadow/openviking mode. Default: fallback to
# OPENVIKING_API_KEY. Without either key a non-SQL knowledge mode refuses to start.
# MULTIREMI_OPENVIKING_API_KEY=replace-with-openviking-api-key

# Optional. Defaults: 30000 ms and 2 retries. Without them OpenViking requests use
# those values. MULTIREMI_OPENVIKING_URL is injected by Docker Compose.
# MULTIREMI_OPENVIKING_TIMEOUT_MS=30000
# MULTIREMI_OPENVIKING_MAX_RETRIES=2

# Optional. Default: unset (outbound Feishu group notifications disabled).
# Without both credentials, Feishu notification delivery fails as unconfigured.
# MULTIREMI_FEISHU_APP_ID=replace-with-feishu-app-id
# MULTIREMI_FEISHU_APP_SECRET=replace-with-feishu-app-secret

# Optional. Default: SDK Feishu domain. Without it outbound notifications use
# the Feishu endpoint selected by the SDK.
# MULTIREMI_FEISHU_DOMAIN=feishu

# Optional. Default: empty registry. Without it Feishu ingestion sources cannot
# resolve an operator-owned sidecar endpoint name.
# MULTIREMI_FEISHU_SIDECAR_ENDPOINTS=personal=http://replace-with-sidecar-host:8042

# Optional. Default: the built-in bootstrap owner open_id. Without an override,
# migrations bind that built-in identity instead of a deployment-specific owner.
# MULTIREMI_OWNER_OPEN_ID=replace-with-owner-open-id

# Optional. Defaults: 2 GiB maximum and 10 GiB required free space. Without them
# archive acceptance uses those limits. The archive root is injected by Compose.
# MULTIREMI_SESSION_ARCHIVE_MAX_BYTES=2147483648
# MULTIREMI_SESSION_ARCHIVE_MIN_FREE_BYTES=10737418240

# Optional. Defaults: 60000 ms base, 3600000 ms maximum, 6 attempts, and 900000 ms
# upload-stall timeout. Without them failed/stalled archives use those policies.
# MULTIREMI_SESSION_ARCHIVE_RETRY_BASE_MS=60000
# MULTIREMI_SESSION_ARCHIVE_RETRY_MAX_MS=3600000
# MULTIREMI_SESSION_ARCHIVE_RETRY_MAX_ATTEMPTS=6
# MULTIREMI_SESSION_ARCHIVE_UPLOAD_STALL_MS=900000

# Optional. Default: 30 seconds. Without it background title scanning uses the
# default interval.
# MULTIREMI_ISSUE_TITLE_INTERVAL_MS=30000

# Optional. Defaults: repository's configured release source and bundled paths.
# Without overrides self-hosted release metadata/scripts use those built-ins.
# MULTIREMI_RELEASE_REPO=replace-with-owner/repository
# MULTIREMI_RELEASE_DIR=replace-with-absolute-release-directory
# MULTIREMI_SCRIPTS_DIR=replace-with-absolute-scripts-directory
