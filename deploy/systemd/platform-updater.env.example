MULTIREMI_API_URL=http://127.0.0.1:6120
MULTIREMI_TOKEN=replace-with-platform-api-token
MULTIREMI_PLATFORM_UPDATER_TOKEN=replace-with-independent-updater-token
MULTIREMI_PLATFORM_DRIVER=systemd_release
# 0 waits for existing tasks without a deadline; positive values limit the wait in ms.
MULTIREMI_PLATFORM_DRAIN_TIMEOUT_MS=0
MULTIREMI_PLATFORM_ROOT=/opt/multiremi-platform
MULTIREMI_PLATFORM_RELEASE_FEED_URL=https://github.com/OWNER/REPO/releases/latest/download/platform-release.json
MULTIREMI_PLATFORM_API_SERVICE=remi-platform-api.service
MULTIREMI_PLATFORM_WEB_SERVICE=remi-platform-web.service
MULTIREMI_PLATFORM_API_HEALTH_URL=http://127.0.0.1:6120/readyz
MULTIREMI_PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:3000/login
MULTIREMI_PLATFORM_POSTGRES_CONTAINER=multiremi-platform-postgres-1
MULTIREMI_PLATFORM_OPENVIKING_CONTAINER=multiremi-platform-openviking-1
# Services the updater pulls, switches and restarts as one batch. Unset keeps the
# single-process topology: `api,web,ssh-mesh-control-plane` are switched and
# `api,web` are pulled. Split API roles add `api-runtime` here, and the pull list
# becomes the same list, so the second container never drifts a release behind:
# MULTIREMI_PLATFORM_CORE_SERVICES=api,web,ssh-mesh-control-plane,api-runtime
#
# Extra health URLs checked after a switch, comma separated. Split API roles
# publish api-runtime on its own port, so a switch is not complete until it
# answers /readyz too:
# MULTIREMI_PLATFORM_EXTRA_HEALTH_URLS=http://127.0.0.1:6121/readyz
